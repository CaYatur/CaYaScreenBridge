<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>CaYaScreenBridge.Windows</RootNamespace>
    <AssemblyName>CaYaScreenBridge</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Left at the framework default. Declaring a higher SupportedOSPlatformVersion would require
      raising TargetPlatformVersion, which pulls in the Windows SDK projections this application has
      no use for. The real minimum (Windows 10 1809) is enforced by the installer instead.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyTitle>CaYaScreenBridge</AssemblyTitle>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Description>Keeps the mouse cursor aligned across displays with different DPI.</Description>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaYaScreenBridge.Core\CaYaScreenBridge.Core.csproj" />
  </ItemGroup>


</Project>
