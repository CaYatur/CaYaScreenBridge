<Window x:Class="CaYaScreenBridge.Windows.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:CaYaScreenBridge.Windows.Ui"
        xmlns:controls="clr-namespace:CaYaScreenBridge.Windows.Ui.Controls"
        Title="CaYaScreenBridge"
        Width="1120"
        Height="740"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource Brush.Base}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== Title bar ==================== -->
            <Border Grid.Row="0" Background="{StaticResource Brush.HeroGlow}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Image Source="/Assets/app-256.png" Width="20" Height="20" />
                        <TextBlock Text="CaYa" FontWeight="Bold" FontSize="14" Margin="10,0,0,0"
                                   Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="ScreenBridge" FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionLabel" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimiseButton" Width="46" Height="46" Click="OnMinimise" Style="{StaticResource Button.Base}"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.TextSecondary}" Content="—" />
                        <Button x:Name="MaximiseButton" Width="46" Height="46" Click="OnMaximise" Style="{StaticResource Button.Base}"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.TextSecondary}" Content="□" />
                        <Button x:Name="CloseButton" Width="46" Height="46" Click="OnClose" Style="{StaticResource Button.Base}"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.TextSecondary}" Content="✕" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== Body ==================== -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="OnTabChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="{ui:S Key=app.tagline}"
                                               Style="{StaticResource Text.Hint}"
                                               Margin="24,20,20,16" />
                                    <StackPanel IsItemsHost="True" Margin="0,0,0,12" />
                                </DockPanel>
                            </Border>

                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="6" Margin="8,1" Cursor="Hand">
                                        <Grid>
                                            <Rectangle x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,8"
                                                       RadiusX="2" RadiusY="2" Fill="{StaticResource Brush.Accent}" Opacity="0" />
                                            <ContentPresenter ContentSource="Header" Margin="18,10" VerticalAlignment="Center"
                                                              TextBlock.FontSize="13"
                                                              TextBlock.Foreground="{StaticResource Brush.TextSecondary}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                                            <Setter TargetName="Marker" Property="Opacity" Value="1" />
                                            <Setter TargetName="Root" Property="TextBlock.Foreground" Value="{StaticResource Brush.Text}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- Overview -->
                <TabItem Header="{ui:S Key=nav.overview}">
                    <ScrollViewer Padding="28,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{ui:S Key=overview.status}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="{Binding IsHealthy, Converter={StaticResource HealthBrush}}" />
                                        <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PolicyText, StringFormat=' · {0}'}"
                                                   Style="{StaticResource Text.Hint}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>

                                    <CheckBox IsChecked="{Binding MasterEnabled, Mode=TwoWay}" Content="{ui:S Key=overview.master}" />
                                    <TextBlock Text="{ui:S Key=overview.masterHint}" Style="{StaticResource Text.Hint}" Margin="42,0,0,4" />
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="4" Margin="0,0,0,14">
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Status.DisplayCount}" Style="{StaticResource Text.Metric}" />
                                        <TextBlock Text="{ui:S Key=overview.displays}" Style="{StaticResource Text.Hint}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="5,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Status.Crossings}" Style="{StaticResource Text.Metric}" />
                                        <TextBlock Text="{ui:S Key=overview.crossings}" Style="{StaticResource Text.Hint}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="5,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Status.Recoveries}" Style="{StaticResource Text.Metric}" />
                                        <TextBlock Text="{ui:S Key=overview.recoveries}" Style="{StaticResource Text.Hint}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Status.HookRestarts}" Style="{StaticResource Text.Metric}" />
                                        <TextBlock Text="{ui:S Key=overview.restarts}" Style="{StaticResource Text.Hint}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{ui:S Key=overview.hook}" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Brush.Text}"
                                                   Text="{Binding Status.HookInstalled, Converter={StaticResource OnOff}}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{ui:S Key=overview.rawinput}" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Brush.Text}"
                                                   Text="{Binding Status.RawInputActive, Converter={StaticResource OnOff}}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="{ui:S Key=displays.profile}" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Brush.Text}"
                                                   FontFamily="{StaticResource Font.Mono}" Text="{Binding ProfileText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Displays -->
                <TabItem Header="{ui:S Key=nav.displays}">
                    <Grid Margin="28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="{ui:S Key=displays.title}" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{ui:S Key=displays.hint}" Style="{StaticResource Text.Hint}" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left" />
                        </StackPanel>

                        <controls:LayoutEditor x:Name="Editor" Grid.Row="1" />

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0"
                                    LostKeyboardFocus="OnDisplayFieldLostFocus"
                                    Visibility="{Binding HasSelectedDisplay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedDisplay.Label}" Style="{StaticResource Text.CardTitle}" />
                                    <TextBlock Text="{Binding SelectedDisplay.Summary}" Style="{StaticResource Text.Hint}" Margin="0,0,0,12" />

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="{ui:S Key=displays.size}" Style="{StaticResource Text.Hint}" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Width="82" SourceUpdated="OnDisplayFieldSourceUpdated"
                                                         Text="{Binding SelectedDisplay.WidthMm, StringFormat=N1, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
                                                <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" />
                                                <TextBox Width="82" SourceUpdated="OnDisplayFieldSourceUpdated"
                                                         Text="{Binding SelectedDisplay.HeightMm, StringFormat=N1, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
                                                <TextBlock Text="{ui:S Key=common.mm}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="{ui:S Key=displays.position}" Style="{StaticResource Text.Hint}" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Width="82" SourceUpdated="OnDisplayFieldSourceUpdated"
                                                         Text="{Binding SelectedDisplay.LeftMm, StringFormat=N1, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
                                                <TextBlock Text="," Margin="8,0" VerticalAlignment="Center" />
                                                <TextBox Width="82" SourceUpdated="OnDisplayFieldSourceUpdated"
                                                         Text="{Binding SelectedDisplay.TopMm, StringFormat=N1, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
                                                <TextBlock Text="{ui:S Key=common.mm}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Content="{ui:S Key=displays.useEdid}" VerticalAlignment="Bottom"
                                                Command="{Binding RevertSizeCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                <CheckBox x:Name="SnapToggle" IsChecked="True" Content="{ui:S Key=displays.snap}" Checked="OnSnapChanged" Unchecked="OnSnapChanged" />
                                <Button Content="{ui:S Key=displays.autoLayout}" Command="{Binding AutoLayoutCommand}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Transition -->
                <TabItem Header="{ui:S Key=nav.transition}">
                    <ScrollViewer Padding="28,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="{ui:S Key=transition.title}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding AlignCursor, Mode=TwoWay}" Content="{ui:S Key=transition.align}" />
                                    <TextBlock Text="{ui:S Key=transition.alignHint}" Style="{StaticResource Text.Hint}" Margin="42,0,0,10" />

                                    <CheckBox IsChecked="{Binding UseRawInputAssist, Mode=TwoWay}" Content="{ui:S Key=transition.rawInput}" />
                                    <TextBlock Text="{ui:S Key=transition.rawInputHint}" Style="{StaticResource Text.Hint}" Margin="42,0,0,10" />

                                    <CheckBox IsChecked="{Binding PreventCursorLoss, Mode=TwoWay}" Content="{ui:S Key=transition.preventLoss}" />
                                    <TextBlock Text="{ui:S Key=transition.preventLossHint}" Style="{StaticResource Text.Hint}" Margin="42,0,0,10" />

                                    <CheckBox IsChecked="{Binding NormalisePointerSpeed, Mode=TwoWay}" Content="{ui:S Key=transition.speed}" />
                                    <TextBlock Text="{ui:S Key=transition.speedHint}" Style="{StaticResource Text.Hint}" Margin="42,0,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{ui:S Key=transition.resistance}" Style="{StaticResource Text.CardTitle}" />
                                    <TextBlock Text="{ui:S Key=transition.resistanceHint}" Style="{StaticResource Text.Hint}" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding BorderResistanceMm, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.Text}"
                                                   Text="{Binding BorderResistanceMm, StringFormat='{}{0:0.0} mm'}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{ui:S Key=transition.wrap}" Style="{StaticResource Text.CardTitle}" />
                                    <ComboBox Margin="0,8,0,0" Width="280" HorizontalAlignment="Left" SelectedIndex="{Binding WrapIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{ui:S Key=transition.wrap.none}" />
                                        <ComboBoxItem Content="{ui:S Key=transition.wrap.horizontal}" />
                                        <ComboBoxItem Content="{ui:S Key=transition.wrap.vertical}" />
                                        <ComboBoxItem Content="{ui:S Key=transition.wrap.both}" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Drag -->
                <TabItem Header="{ui:S Key=nav.drag}">
                    <ScrollViewer Padding="28,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="{ui:S Key=drag.title}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{ui:S Key=drag.mode}" Style="{StaticResource Text.CardTitle}" />
                                    <ComboBox Margin="0,8,0,10" Width="320" HorizontalAlignment="Left" SelectedIndex="{Binding DragModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{ui:S Key=drag.mode.off}" />
                                        <ComboBoxItem Content="{ui:S Key=drag.mode.drop}" />
                                        <ComboBoxItem Content="{ui:S Key=drag.mode.live}" />
                                    </ComboBox>
                                    <TextBlock Text="{ui:S Key=drag.modeHint}" Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding PreserveGrabPoint, Mode=TwoWay}" Content="{ui:S Key=drag.grab}" />

                                    <CheckBox IsChecked="{Binding SkipDpiUnawareWindows, Mode=TwoWay}" Content="{ui:S Key=drag.skipUnaware}" />
                                    <TextBlock Text="{ui:S Key=drag.skipUnawareHint}" Style="{StaticResource Text.Hint}" Margin="42,0,0,10" />

                                    <CheckBox IsChecked="{Binding SkipMaximisedWindows, Mode=TwoWay}" Content="{ui:S Key=drag.skipMaximised}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{ui:S Key=drag.throttle}" Style="{StaticResource Text.CardTitle}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                                                Value="{Binding LiveThrottleMs, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.Text}"
                                                   Text="{Binding LiveThrottleMs, StringFormat='{}{0:0} ms'}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Rules -->
                <TabItem Header="{ui:S Key=nav.rules}">
                    <Grid Margin="28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="{ui:S Key=rules.games}" Style="{StaticResource Text.Title}" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding PauseInExclusiveFullScreen, Mode=TwoWay}" Content="{ui:S Key=rules.exclusive}" />
                                <TextBlock Text="{ui:S Key=rules.exclusiveHint}" Style="{StaticResource Text.Hint}" Margin="42,0,0,10" />

                                <CheckBox IsChecked="{Binding CorrectInBorderlessFullScreen, Mode=TwoWay}" Content="{ui:S Key=rules.borderless}" />

                                <CheckBox IsChecked="{Binding PauseForAntiCheat, Mode=TwoWay}" Content="{ui:S Key=rules.anticheat}" />
                                <TextBlock Text="{ui:S Key=rules.anticheatHint}" Style="{StaticResource Text.Hint}" Margin="42,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="{ui:S Key=rules.title}" Style="{StaticResource Text.CardTitle}" />
                                    <TextBlock Text="{ui:S Key=rules.hint}" Style="{StaticResource Text.Hint}" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="{ui:S Key=common.add}" Command="{Binding AddRuleCommand}" Margin="0,0,8,0" />
                                        <Button Content="{ui:S Key=common.remove}" Command="{Binding RemoveRuleCommand}" />
                                    </StackPanel>
                                </StackPanel>

                                <ListBox ItemsSource="{Binding Rules}"
                                         SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                         LostKeyboardFocus="OnRuleLostFocus"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Process, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0" />
                                                <ComboBox Grid.Column="1" SelectedIndex="{Binding Action, Mode=TwoWay, Converter={StaticResource EnumIndex}}">
                                                    <ComboBoxItem Content="{ui:S Key=rules.action.correct}" />
                                                    <ComboBoxItem Content="{ui:S Key=rules.action.passthrough}" />
                                                    <ComboBoxItem Content="{ui:S Key=rules.action.noscale}" />
                                                </ComboBox>
                                                <CheckBox Grid.Column="2" Margin="14,0,0,0" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Startup -->
                <TabItem Header="{ui:S Key=nav.startup}">
                    <ScrollViewer Padding="28,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="{ui:S Key=startup.title}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Content="{ui:S Key=startup.enable}" />

                                    <CheckBox IsChecked="{Binding StartElevated, Mode=TwoWay}" Content="{ui:S Key=startup.elevated}" />
                                    <TextBlock Text="{ui:S Key=startup.elevatedHint}" Style="{StaticResource Text.Hint}" Margin="42,0,0,10" />

                                    <CheckBox IsChecked="{Binding StartMinimised, Mode=TwoWay}" Content="{ui:S Key=startup.minimised}" />
                                    <CheckBox IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}" Content="{ui:S Key=startup.tray}" />

                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="{ui:S Key=startup.method}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StartupSummary}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                                            <Button Content="{ui:S Key=startup.repair}" Command="{Binding RepairStartupCommand}" Margin="12,0,0,0" Padding="12,6" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding RaiseHookTimeout, Mode=TwoWay}" Content="{ui:S Key=startup.hookTimeout}" />
                                    <TextBlock Text="{ui:S Key=startup.hookTimeoutHint}" Style="{StaticResource Text.Hint}" Margin="42,0,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{ui:S Key=startup.language}" Style="{StaticResource Text.CardTitle}" />
                                    <ComboBox Margin="0,8,0,8" Width="260" HorizontalAlignment="Left" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Otomatik / Automatic" />
                                        <ComboBoxItem Content="Türkçe" />
                                        <ComboBoxItem Content="English" />
                                    </ComboBox>
                                    <TextBlock Text="{ui:S Key=startup.languageHint}" Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Diagnostics -->
                <TabItem Header="{ui:S Key=nav.diagnostics}">
                    <Grid Margin="28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{ui:S Key=diag.title}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="{ui:S Key=diag.live}" />
                                    <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource Font.Mono}"
                                               Foreground="{StaticResource Brush.Text}" Text="{Binding LiveCursor}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{ui:S Key=diag.rebuild}" Command="{Binding RebuildLayoutCommand}" Margin="0,0,8,0" />
                                    <Button Content="{ui:S Key=diag.copy}" Command="{Binding CopyLogCommand}" Margin="0,0,8,0" />
                                    <Button Content="{ui:S Key=diag.openFolder}" Command="{Binding OpenLogFolderCommand}" Margin="0,0,16,0" />
                                    <CheckBox IsChecked="{Binding VerboseLogging, Mode=TwoWay}" Content="{ui:S Key=diag.verbose}" VerticalAlignment="Center" Margin="0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="2">
                            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="14">
                                <TextBlock Text="{Binding LogText}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ==================== Status bar ==================== -->
            <Border Grid.Row="2" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Hint}" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Hint}" Text="cayadev.com" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
